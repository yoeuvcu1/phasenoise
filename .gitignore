# Ignore everything by default, then allow project text files.
*
!*/
!*.m
!*.py
!*.md
!*.txt
!*.csv
!*.json
!*.jsonc
!*.yaml
!*.yml
!*.docx
!**/report_assets/figures/*.png
~$*.docx
!.gitignore

# Generated simulation output must never be versioned.
**/results/

# Task-local Python wheels used while building/verifying reports.
**/.python_deps/
